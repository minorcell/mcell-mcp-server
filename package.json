{
  "name": "@mcell/mcell-mcp-server",
  "version": "0.1.2",
  "description": "A stdio MCP server with image processing and S3 upload tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcell-mcp-server": "dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --minify --outfile=dist/index.js",
    "build": "npm run clean && npm run build:bundle",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run format:check && npm run check && npm run test:coverage && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stdio",
    "image",
    "s3"
  ],
  "author": "mcell",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.996.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "mime-types": "^3.0.1",
    "node-notifier": "^10.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@types/node-notifier": "^8.0.5",
    "@vitest/coverage-v8": "^4.0.7",
    "esbuild": "^0.27.0",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.7"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/minorcell/mcell-mcp-server"
  },
  "homepage": "https://github.com/minorcell/mcell-mcp-server",
  "bugs": {
    "url": "https://github.com/minorcell/mcell-mcp-server/issues"
  }
}
